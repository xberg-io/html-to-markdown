[
  {
    "id": "link_simple",
    "description": "Simple link",
    "input": {
      "html": "<a href=\"https://example.com\">Example</a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "[Example](https://example.com)"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_simple",
      "title": "Simple link"
    }
  },
  {
    "id": "link_with_title",
    "description": "Link with title attribute",
    "input": {
      "html": "<a href=\"https://example.com\" title=\"Example Site\">Example</a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "[Example](https://example.com",
          "Example Site"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_with_title",
      "title": "Link with title attribute"
    }
  },
  {
    "id": "link_mailto",
    "description": "Mailto link is preserved with mailto: scheme",
    "input": {
      "html": "<a href=\"mailto:user@example.com\">Email us</a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "mailto:user@example.com"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_mailto",
      "title": "Mailto link is preserved with mailto: scheme"
    }
  },
  {
    "id": "link_anchor_fragment",
    "description": "Fragment-only anchor link is preserved",
    "input": {
      "html": "<a href=\"#section\">Jump to section</a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "[Jump to section](#section)"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_anchor_fragment",
      "title": "Fragment-only anchor link is preserved"
    }
  },
  {
    "id": "link_with_bold_text",
    "description": "Link containing bold text preserves formatting",
    "input": {
      "html": "<a href=\"https://example.com\"><strong>Bold link</strong></a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "**Bold link**",
          "https://example.com"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_with_bold_text",
      "title": "Link containing bold text preserves formatting"
    }
  },
  {
    "id": "link_empty_href",
    "description": "Link with empty href produces output with the link text",
    "input": {
      "html": "<a href=\"\">No destination</a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "No destination"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_empty_href",
      "title": "Link with empty href produces output with the link text"
    }
  },
  {
    "id": "link_image_inside",
    "description": "Image inside a link produces a linked image",
    "input": {
      "html": "<a href=\"https://example.com\"><img src=\"logo.png\" alt=\"Logo\"></a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "![Logo](logo.png)",
          "https://example.com"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_image_inside",
      "title": "Image inside a link produces a linked image"
    }
  },
  {
    "id": "link_wrapping_table_renders_table",
    "description": "An anchor wrapping a table renders the table as a block instead of an escaped link label",
    "input": {
      "html": "<a href=\"https://example.com/outer\"><table><tr><td><a href=\"https://example.com/inner\">Inner</a></td></tr></table></a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "[https://example.com/outer](https://example.com/outer)",
          "[Inner](https://example.com/inner)"
        ]
      },
      {
        "type": "not_contains",
        "field": "content",
        "value": "\\|"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_wrapping_table_renders_table",
      "title": "An anchor wrapping a table renders the table"
    }
  },
  {
    "id": "link_trailing_line_break_is_kept",
    "description": "A <br> just before </a> is kept as a hard line break in the label",
    "input": {
      "html": "<a href=\"https://example.com\">Alpha<br></a>Beta"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "[Alpha  \n](https://example.com)Beta"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_trailing_line_break_is_kept",
      "title": "A <br> just before </a> is kept as a hard line break in the label"
    }
  },
  {
    "id": "link_leading_line_break_is_kept",
    "description": "A <br> just after <a> is kept as a hard line break in the label",
    "input": {
      "html": "Beta<a href=\"https://example.com\"><br>Alpha</a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Beta[  \nAlpha](https://example.com)"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_leading_line_break_is_kept",
      "title": "A <br> just after <a> is kept as a hard line break in the label"
    }
  },
  {
    "id": "link_label_block_marker_is_escaped",
    "description": "A block marker on a continuation line of a link label is escaped",
    "input": {
      "html": "<a href=\"https://example.com\">Alpha<br>-<br>Beta</a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "[Alpha  \n\\-  \nBeta](https://example.com)"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_label_block_marker_is_escaped",
      "title": "A block marker on a continuation line of a link label is escaped"
    }
  },
  {
    "id": "link_href_entity_shaped_ampersand_kept_literal",
    "description": "An & that would read as a character reference in a link destination or title stays literal",
    "input": {
      "html": "<a href=\"?&amp;plus;\" title=\"&amp;plus;\">T</a>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "[T](?&amp;plus; \"&amp;plus;\")\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_href_entity_shaped_ampersand_kept_literal",
      "title": "An & that would read as a character reference in a link destination or title stays literal"
    }
  },
  {
    "id": "link_label_unmatched_open_bracket_is_escaped",
    "description": "An unmatched [ in a link label is escaped so the link survives",
    "input": {
      "html": "<a href=\"S\">[A;B)</a>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "[\\[A;B)](S)\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_label_unmatched_open_bracket_is_escaped",
      "title": "An unmatched [ in a link label is escaped so the link survives"
    }
  },
  {
    "id": "link_split_by_block_child_is_not_duplicated",
    "description": "An anchor wrapping a block that holds another anchor records its destination once, not twice",
    "input": {
      "html": "<a href=\"/o\"><div><a href=\"/i\">Inner</a></div></a>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "[](/o)\n\n[Inner](/i)\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_split_by_block_child_is_not_duplicated",
      "title": "An anchor wrapping a block that holds another anchor records its destination once, not twice"
    }
  },
  {
    "id": "link_split_keeps_text_bearing_half",
    "description": "An anchor split around a block keeps the half that carries its text",
    "input": {
      "html": "<a href=\"/o\">Text<div><a href=\"/i\">Inner</a></div></a>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "[Text](/o)\n\n[Inner](/i)\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_split_keeps_text_bearing_half",
      "title": "An anchor split around a block keeps the half that carries its text"
    }
  },
  {
    "id": "link_split_drops_empty_authored_half",
    "description": "An anchor split around a block drops its empty half when the reconstructed half carries the text",
    "input": {
      "html": "<a href=\"/o\"><div>Text<a href=\"/i\">Inner</a></div></a>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "[Text](/o)[Inner](/i)\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "link_split_drops_empty_authored_half",
      "title": "An anchor split around a block drops its empty half when the reconstructed half carries the text"
    }
  }
]
