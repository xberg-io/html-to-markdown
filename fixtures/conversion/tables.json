[
  {
    "id": "simple_table",
    "description": "Simple table with header",
    "input": {
      "html": "<table><thead><tr><th>Name</th><th>Age</th></tr></thead><tbody><tr><td>Alice</td><td>30</td></tr></tbody></table>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Name",
          "Age",
          "Alice",
          "30",
          "|",
          "---"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "simple_table",
      "title": "Simple table with header"
    }
  },
  {
    "id": "table_no_thead",
