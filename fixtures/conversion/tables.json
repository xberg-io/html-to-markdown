    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Product",
          "Price",
          "Apple",
          "1.00",
          "|"
        ]
      }
    ],
    "docs": {
