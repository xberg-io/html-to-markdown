      "html": "<table><tr><th>A</th><th>B</th><th>C</th></tr><tr><td>1</td><td>2</td></tr></table>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "| A | B | C |\n| --- | --- | --- |\n| 1 | 2 |   |\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "table_ragged_row_fewer_cells_than_header",
      "title": "A data row with fewer cells than the header is padded to the declared column count"
    }
