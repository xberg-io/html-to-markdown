  {
    "id": "table_ragged_row_more_cells_than_header",
    "description": "A data row with more cells than the header widens the separator so no cell is silently dropped",
    "input": {
      "html": "<table><tr><th>A</th><th>B</th></tr><tr><td>1</td><td>2</td><td>3</td></tr></table>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "| A | B |   |\n| --- | --- | --- |\n| 1 | 2 | 3 |\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "table_ragged_row_more_cells_than_header",
      "title": "A data row with more cells than the header widens the separator so no cell is silently dropped"
    }
  },
  {
    "id": "table_ragged_row_fewer_cells_than_header",
    "description": "A data row with fewer cells than the header is padded to the declared column count",
