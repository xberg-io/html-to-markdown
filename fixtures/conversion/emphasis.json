[
  {
    "id": "bold_strong",
    "description": "Strong tag converts to bold",
    "input": {
      "html": "<p><strong>bold</strong></p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "**bold**"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "bold_strong",
      "title": "Strong tag converts to bold"
    }
  },
  {
    "id": "italic_em",
    "description": "Em tag converts to italic",
    "input": {
      "html": "<p><em>italic</em></p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "*italic*"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "italic_em",
      "title": "Em tag converts to italic"
    }
  },
  {
    "id": "bold_and_italic",
    "description": "Nested bold and italic",
    "input": {
      "html": "<p><strong><em>both</em></strong></p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "***both***"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "bold_and_italic",
      "title": "Nested bold and italic"
    }
  },
  {
    "id": "emphasis_strikethrough_s",
    "description": "s tag converts to GFM strikethrough",
    "input": {
      "html": "<p><s>strikethrough</s></p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "~~strikethrough~~"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "emphasis_strikethrough_s",
      "title": "s tag converts to GFM strikethrough"
    }
  },
  {
    "id": "emphasis_strikethrough_del",
    "description": "del tag converts to GFM strikethrough",
    "input": {
      "html": "<p><del>deleted text</del></p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "~~deleted text~~"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "emphasis_strikethrough_del",
      "title": "del tag converts to GFM strikethrough"
    }
  },
  {
    "id": "emphasis_underline_u",
    "description": "u tag content is preserved in output",
    "input": {
      "html": "<p><u>underlined</u></p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "underlined"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "emphasis_underline_u",
      "title": "u tag content is preserved in output"
    }
  },
  {
    "id": "emphasis_mark_highlight",
    "description": "mark tag produces highlighted output",
    "input": {
      "html": "<p><mark>highlighted</mark></p>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "highlighted"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "emphasis_mark_highlight",
      "title": "mark tag produces highlighted output"
    }
  },
  {
    "id": "emphasis_subscript",
    "description": "sub tag content is preserved",
    "input": {
      "html": "<p>H<sub>2</sub>O</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "H",
          "2",
          "O"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "emphasis_subscript",
      "title": "sub tag content is preserved"
    }
  },
  {
    "id": "emphasis_superscript",
    "description": "sup tag content is preserved",
    "input": {
      "html": "<p>x<sup>2</sup></p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "x",
          "2"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "emphasis_superscript",
      "title": "sup tag content is preserved"
    }
  },
  {
    "id": "adjacent_emphasis_merged",
    "description": "Adjacent emphasis elements share one delimiter run",
    "input": {
      "html": "<p><i>A</i><i>B</i><i>C</i></p>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "*ABC*\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "adjacent_emphasis_merged",
      "title": "Adjacent emphasis elements share one delimiter run"
    }
  },
  {
    "id": "tagged_space_not_duplicated",
    "description": "A whitespace-only inline element contributes exactly one space",
    "input": {
      "html": "<p>A<i> </i>B</p>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "A B\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "tagged_space_not_duplicated",
      "title": "A whitespace-only inline element contributes exactly one space"
    }
  }
]
