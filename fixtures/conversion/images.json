[
  {
    "id": "image_simple",
    "description": "Image with alt text",
    "input": {
      "html": "<img src=\"photo.jpg\" alt=\"A photo\">"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "![A photo](photo.jpg)"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "image_simple",
      "title": "Image with alt text"
    }
  },
  {
    "id": "image_no_alt",
    "description": "Image without alt text produces image markdown",
    "input": {
      "html": "<img src=\"banner.jpg\">"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "banner.jpg"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "image_no_alt",
      "title": "Image without alt text produces image markdown"
    }
  },
  {
    "id": "image_with_title",
    "description": "Image with title attribute includes title in output",
    "input": {
      "html": "<img src=\"chart.png\" alt=\"Sales chart\" title=\"Q3 Sales\">"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "![Sales chart](chart.png",
          "Q3 Sales"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "image_with_title",
      "title": "Image with title attribute includes title in output"
    }
  },
  {
    "id": "image_figure_figcaption",
    "description": "Figure with figcaption preserves both image and caption",
    "input": {
      "html": "<figure><img src=\"sunset.jpg\" alt=\"A sunset\"><figcaption>Beautiful sunset over the ocean</figcaption></figure>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "![A sunset](sunset.jpg)",
          "Beautiful sunset over the ocean"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "image_figure_figcaption",
      "title": "Figure with figcaption preserves both image and caption"
    }
  },
  {
    "id": "image_linked",
    "description": "Image inside an anchor produces a linked image",
    "input": {
      "html": "<a href=\"https://example.com\"><img src=\"icon.png\" alt=\"Icon\"></a>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "![Icon](icon.png)",
          "https://example.com"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "image_linked",
      "title": "Image inside an anchor produces a linked image"
    }
  },
  {
    "id": "image_kept_inline_in_link",
    "description": "keep_inline_images_in naming 'a' keeps an image inside a link that also holds a block element",
    "input": {
      "html": "<a href=\"https://example.com/file.pdf\"><img src=\"pdf.png\"><p>Download PDF</p></a>",
      "options": {
        "keep_inline_images_in": [
          "a"
        ]
      }
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "![](pdf.png)",
          "Download PDF",
          "https://example.com/file.pdf"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "image_kept_inline_in_link",
      "title": "keep_inline_images_in keeps an image inside a link"
    }
  },
  {
    "id": "image_multiline_alt_block_marker_is_escaped",
    "description": "A block marker on a continuation line of multiline alt text is escaped",
    "input": {
      "html": "<img alt=\"Alpha\n-\nBeta\" src=\"image.png\">"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "![Alpha\n\\-\nBeta](image.png)"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "image_multiline_alt_block_marker_is_escaped",
      "title": "A block marker on a continuation line of multiline alt text is escaped"
    }
  }
]
