[
  {
    "id": "inline_code",
    "description": "Inline code",
    "input": {
      "html": "<p>Use <code>console.log()</code> to debug</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "`console.log()`"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "inline_code",
      "title": "Inline code"
    }
  },
  {
    "id": "code_block",
    "description": "Code block with language preserves content",
    "input": {
      "html": "<pre><code class=\"language-python\">print('hello')</code></pre>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "print('hello')"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "code_block",
      "title": "Code block with language preserves content"
    }
  },
  {
    "id": "code_block_no_language",
    "description": "Code block without a language class preserves content",
    "input": {
      "html": "<pre><code>plain code here</code></pre>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "plain code here"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "code_block_no_language",
      "title": "Code block without a language class preserves content"
    }
  },
  {
    "id": "code_with_backticks_in_content",
    "description": "Inline code containing backtick characters is properly escaped",
    "input": {
      "html": "<p>Use <code>`backtick` here</code> carefully.</p>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "backtick"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "code_with_backticks_in_content",
      "title": "Inline code containing backtick characters is properly escaped"
    }
  },
  {
    "id": "code_inline_in_paragraph",
    "description": "Inline code element nested inside a paragraph",
    "input": {
      "html": "<p>Call the <code>initialize()</code> method first.</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "`initialize()`"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "code_inline_in_paragraph",
      "title": "Inline code element nested inside a paragraph"
    }
  },
  {
    "id": "adjacent_code_spans_merged",
    "description": "Adjacent code spans merge instead of colliding backticks",
    "input": {
      "html": "<p><code>A</code><code>B</code></p>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "`AB`\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "adjacent_code_spans_merged",
      "title": "Adjacent code spans merge instead of colliding backticks"
    }
  },
  {
    "id": "whitespace_only_code_span_kept",
    "description": "A code span whose content is a single space survives",
    "input": {
      "html": "<p>A<code> </code>B</p>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "A` `B\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "whitespace_only_code_span_kept",
      "title": "A code span whose content is a single space survives"
    }
  },
  {
    "id": "code_span_suppresses_nested_inline_markers",
    "description": "Inline markers inside a code span stay literal content",
    "input": {
      "html": "<p><code>a<em>b</em><ins>c</ins></code></p>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "`abc`\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "code_span_suppresses_nested_inline_markers",
      "title": "Inline markers inside a code span stay literal content"
    }
  }
]
