[
  {
    "id": "paragraph_simple",
    "description": "Simple paragraph converts to plain text",
    "input": {
      "html": "<p>Hello World</p>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "Hello World\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "paragraph_simple",
      "title": "Simple paragraph converts to plain text"
    }
  },
  {
    "id": "paragraph_multiple",
    "description": "Multiple paragraphs are separated by a blank line",
    "input": {
      "html": "<p>First paragraph.</p><p>Second paragraph.</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "First paragraph.",
          "Second paragraph."
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "paragraph_multiple",
      "title": "Multiple paragraphs are separated by a blank line"
    }
  },
  {
    "id": "paragraph_with_inline_formatting",
    "description": "Paragraph with bold, italic, and a link",
    "input": {
      "html": "<p>This has <strong>bold</strong>, <em>italic</em>, and a <a href=\"https://example.com\">link</a>.</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "**bold**",
          "*italic*",
          "[link](https://example.com)"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "paragraph_with_inline_formatting",
      "title": "Paragraph with bold, italic, and a link"
    }
  },
  {
    "id": "paragraph_with_line_breaks",
    "description": "Paragraph with br tags produces line breaks in output",
    "input": {
      "html": "<p>Line one.<br>Line two.<br>Line three.</p>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Line one.",
          "Line two.",
          "Line three."
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "paragraph_with_line_breaks",
      "title": "Paragraph with br tags produces line breaks in output"
    }
  },
  {
    "id": "paragraph_nested_divs",
    "description": "Text nested inside divs is extracted correctly",
    "input": {
      "html": "<div><div><p>Nested text</p></div></div>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Nested text"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "paragraph_nested_divs",
      "title": "Text nested inside divs is extracted correctly"
    }
  },
  {
    "id": "paragraph_whitespace_only_span_separates_words",
    "description": "A newline-only inline wrapper still separates the words on either side",
    "input": {
      "html": "Alpha<span style=\"white-space:pre\">\n</span>13"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "Alpha 13\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "paragraph_whitespace_only_span_separates_words",
      "title": "A newline-only inline wrapper still separates the words on either side"
    }
  },
  {
    "id": "div_whitespace_only_span_does_not_indent_image",
    "description": "A whitespace-only span opening a div does not indent the image after it into a code block",
    "input": {
      "html": "<p>P</p>\n<div>\n<span>    </span><img alt=\"A\" src=\"S\"/>\n</div>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "P\n\n![A](S)\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "div_whitespace_only_span_does_not_indent_image",
      "title": "A whitespace-only span opening a div does not indent the image after it into a code block"
    }
  },
  {
    "id": "nested_newline_only_spans_keep_separator",
    "description": "A newline inside two nested spans still separates the words on either side",
    "input": {
      "html": "<p>Alpha<span><span>\n</span></span>Beta</p>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "Alpha Beta\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "nested_newline_only_spans_keep_separator",
      "title": "A newline inside two nested spans still separates the words on either side"
    }
  }
]
