  {
    "id": "options_accessible_names_link_auto_enabled",
    "description": "Auto link conversion with accessible names enabled",
    "call": "accessible_names",
    "input": {
      "html": "<p>see <a href=\"https://example.com/x\">GitHub<svg aria-label=\"(opens in new tab)\"><use href=\"#ext\"></use></svg></a> now</p>",
      "options": {
        "tier_strategy": "Auto",
        "inline_data_media": "AltTextOnly"
      },
      "use_accessible_names": true
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "see [GitHub (opens in new tab)](https://example.com/x) now\n"
      }
    ],
    "docs": {
      "topic": "options",
      "stem": "options_accessible_names_link_auto_enabled",
      "title": "Auto link conversion with accessible names enabled"
    }
