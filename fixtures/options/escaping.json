[
  {
    "id": "options_escape_asterisks",
    "description": "escape_asterisks option escapes asterisks in plain text",
    "input": {
      "html": "<p>Use 2*3 = 6 in math.</p>",
      "options": {
        "escape_asterisks": true
      }
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "2",
          "3",
          "6"
        ]
      }
    ],
    "docs": {
      "topic": "options",
      "stem": "options_escape_asterisks",
      "title": "escape_asterisks option escapes asterisks in plain text"
    }
  },
