  {
    "id": "options_br_in_tables_nested_table_rows",
    "description": "A nested table flattened into a cell keeps its row boundaries as literal <br> when br_in_tables is enabled",
    "input": {
      "html": "<table><tr><td><p>Before</p><table><tr><th>ID</th><th>Status</th></tr><tr><td>123</td><td>Done</td></tr></table></td><td>Other</td></tr></table>",
      "options": {
        "br_in_tables": true,
        "compact_tables": true
      }
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Before<br>",
          "<br>",
          "123",
          "Done",
          "Status"
        ]
      }
    ],
    "docs": {
      "topic": "options",
      "stem": "options_br_in_tables_nested_table_rows",
      "title": "A flattened nested table keeps its row boundaries under br_in_tables"
    }
  },
  {
    "id": "options_br_in_tables_nested_data_table",
    "description": "A single-cell layout wrapper preserves its nested data table as structured Markdown",
    "input": {
      "html": "<table><tr><td><p>Before</p><table><tr><th>ID</th><th>Status</th></tr><tr><td>123</td><td>Done</td></tr></table></td></tr></table>",
      "options": {
        "br_in_tables": true,
        "compact_tables": true
      }
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "Before\n\n| ID | Status |\n| --- | --- |\n| 123 | Done |\n"
      }
    ],
    "docs": {
      "topic": "options",
      "stem": "options_br_in_tables_nested_data_table",
      "title": "A single-cell layout wrapper preserves its nested data table"
    }
  },
  {
    "id": "options_br_in_tables_anchor_wrapped_nested_table_in_layout_cell",
    "description": "An anchor-wrapped table inside a layout cell keeps its inner links clickable",
    "input": {
      "html": "<table><tr><td><a href=\"/outer\"><table><tr><td><a href=\"/one\">One</a><a href=\"/two\">Two</a></td></tr></table></a></td></tr><tr><td>After</td></tr></table>",
      "options": {
        "br_in_tables": true,
        "compact_tables": true
      }
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "- [/outer](/outer)\n\n| [One](/one)[Two](/two) |\n| --- |\n- After\n"
      }
    ],
    "docs": {
      "topic": "options",
      "stem": "options_br_in_tables_anchor_wrapped_nested_table_in_layout_cell",
      "title": "An anchor-wrapped table inside a layout cell keeps its inner links clickable"
    }
  }
